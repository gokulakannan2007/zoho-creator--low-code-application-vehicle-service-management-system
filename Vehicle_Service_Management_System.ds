ock Level by Quantity Available'\n\t\n\t\ttitleSize = '15px'\n\ttype = 'Scatter'\n\txtitle = 'Minimum Stock Level'\n\tytitle = 'Quantity Available'\n\tbgColor = '#FFFFFF'\n\ttheme = '#198391'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'spare_parts_inventory'\n\txfield = 'minimum_stock_level'\n\tyfields = 'value:quantity_available'\n\tgroupBy = 'part_name'\n\t\tDelugeCriteria = 'minimum_stock_level is not null'\n/>\n\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'service_booking_Report'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_Export = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_Search = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'custom'\n\theightValue = '500'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			notify_customer_on_approval as "Notify Customer on Approval"
			{
				type =  form
				form = service_booking

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the service booking record that was just approved
										serviceBookingRecord = service_booking[ID == input.ID];
										// Validate that the booking exists and has a customer
										if(serviceBookingRecord.customer.isNull())
										{
											info "No customer associated with this booking";
										}
										else
										{
											// Get customer details from the lookup
											customerRecord = customer_details[ID == serviceBookingRecord.customer];
											// Validate customer email exists
											if(customerRecord.email.isNull())
											{
												info "Customer email is not available";
											}
											else
											{
												// Get booking details
												bookingCode = serviceBookingRecord.booking_code;
												bookingStatus = serviceBookingRecord.booking_status;
												bookingDate = serviceBookingRecord.booking_date;
												// Construct email message
												emailSubject = "Service Booking Approved - " + bookingCode;
												emailMessage = "Dear " + customerRecord.customer_name.first_name + ",\n\n";
												emailMessage = emailMessage.concat("Your service booking has been approved.\n");
												emailMessage = emailMessage.concat("Booking Code: " + bookingCode + "\n");
												emailMessage = emailMessage.concat("Booking Date: " + bookingDate.toString() + "\n");
												emailMessage = emailMessage.concat("Status: " + bookingStatus + "\n\n");
												emailMessage = emailMessage.concat("Thank you for choosing our services.\n");
												emailMessage = emailMessage.concat("Best regards,\nVehicle Service Management Team");
												// Send email to customer
												sendmail
												[
													from :zoho.loginuserid
													to :customerRecord.email
													subject :emailSubject
													message :emailMessage
													content type :Plain Text
												]
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			low_stock_alert_reminder as "Low Stock Alert Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch spare parts with low stock (quantity_available <= minimum_stock_level)
										lowStockParts = spare_parts_inventory[quantity_available <= minimum_stock_level];
										// Check if there are any low stock items
										if(lowStockParts.count() > 0)
										{
											// Build notification message
											notificationMessage = "The following spare parts have low stock:\n\n";
											for each  part in lowStockParts
											{
												notificationMessage = notificationMessage.concat(part.part_name + " - Available: " + part.quantity_available.toString() + " (Min: " + part.minimum_stock_level.toString() + ")\n");
											}
											// Send email notification to manager
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.loginuserid
												subject :"Daily Low Stock Alert - Spare Parts Inventory"
												message :notificationMessage
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}


